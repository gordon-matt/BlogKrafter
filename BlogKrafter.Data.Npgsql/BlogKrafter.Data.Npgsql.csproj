<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>PostgreSQL storage for the BlogKrafter blog engine.</Description>
		<PackageTags>blog;blogging;entity-framework-core;efcore;postgresql;npgsql</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BlogKrafter.Data\BlogKrafter.Data.csproj" />
	</ItemGroup>

</Project>
