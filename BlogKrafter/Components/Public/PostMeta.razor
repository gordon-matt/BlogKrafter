<p class="bk-meta">
    @if (LocalPublishedAt is DateTime published)
    {
        <time datetime="@published.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@FormatDate(published)</time>
    }
    @if (!string.IsNullOrWhiteSpace(AuthorName))
    {
        <span>@AuthorName</span>
    }
    @if (ReadingTimeMinutes > 0)
    {
        <span>@ReadingTimeMinutes min read</span>
    }
    @if (Category is not null)
    {
        <a href="@Urls.Category(Category.Slug)">@Category.Name</a>
    }
</p>
