	<ItemGroup>
		<ProjectReference Include="..\BlogKrafter.Services\BlogKrafter.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="BlogKrafter.Tests" />
