<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>MySQL storage for the BlogKrafter blog engine.</Description>
		<PackageTags>blog;blogging;entity-framework-core;efcore;mysql</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BlogKrafter.Data\BlogKrafter.Data.csproj" />
	</ItemGroup>

</Project>
